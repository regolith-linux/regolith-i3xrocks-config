#!/bin/bash

# Network devices attached to a bridge or another master device, such as the
# vnetN tap devices libvirt adds to virbr0 for each running guest. NetworkManager
# reports them as tun connections, but they carry VM traffic, not a VPN tunnel.
PORTS=""
for dev in /sys/class/net/*; do
    [ -e "$dev/master" ] && PORTS="$PORTS ${dev##*/}"
done

CONNECTION=$(LC_ALL=C nmcli -t connection show --active | awk -F ':' -v ports="$PORTS" '
BEGIN { n = split(ports, p, " "); for (i = 1; i <= n; i++) port[p[i]] = 1 }
{ if($3 == "vpn") {
    vpn_name=$1
  } else if (($3 == "tun" || $3 == "tap") && !($4 in port)){
    tun_name=$1
  } else if ($3 == "wireguard"){
    tun_name=$1
  }
}
END{if (vpn_name) {printf("%s", vpn_name)}  else if(tun_name) {printf("%s", tun_name)}}')
LABEL_COLOR=${vpn_label_color:-$(xrescat i3xrocks.label.color)}
VALUE_COLOR="${vpn_color:-$(xrescat i3xrocks.value.color)}"
VALUE_FONT=${font:-$(xrescat i3xrocks.value.font)}

if [[ -z "$CONNECTION" ]]; then
    exit 0
else
    echo "<span color=\"${LABEL_COLOR}\" font_desc=\"${VALUE_FONT}\"> </span><span font_desc=\"${VALUE_FONT}\" color=\"${VALUE_COLOR}\">$CONNECTION</span>" # full text
    echo "<span color=\"${LABEL_COLOR}\" font_desc=\"${VALUE_FONT}\"> </span>" # short text
fi
